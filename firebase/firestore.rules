rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Revisores: se agregan a mano en la consola de Firebase (colección "revisores", documento = UID).
    function esRevisor() {
      return request.auth != null
        && exists(/databases/$(database)/documents/revisores/$(request.auth.uid));
    }
    // Campos que solo puede tocar un revisor.
    function camposDeRevision() {
      return ['validacion', 'especieValidada', 'especieValidadaId', 'revisor', 'revisadoEn', 'notaRevision'];
    }

    match /registros/{id} {
      // Cualquier persona con la app (sesión anónima) puede ver las fotos de la comunidad.
      allow read: if request.auth != null;

      // Crear: solo a nombre propio y sin campos de revisión.
      allow create: if request.auth != null
        && request.resource.data.uidAutor == request.auth.uid
        && !request.resource.data.keys().hasAny(camposDeRevision());

      // Actualizar: el autor (sin tocar la revisión) o un revisor.
      allow update: if esRevisor()
        || (request.auth != null
            && resource.data.uidAutor == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(camposDeRevision()));

      allow delete: if esRevisor();
    }

    // Fotos reducidas (máx. 800 px), una por registro. Se guardan aquí porque el plan gratuito no incluye Storage.
    match /fotos/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uidAutor == request.auth.uid
        && request.resource.data.datos is string
        && request.resource.data.datos.size() < 900000;
      allow update: if request.auth != null
        && resource.data.uidAutor == request.auth.uid
        && request.resource.data.uidAutor == request.auth.uid
        && request.resource.data.datos is string
        && request.resource.data.datos.size() < 900000;
      allow delete: if esRevisor();
    }

    match /revisores/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
